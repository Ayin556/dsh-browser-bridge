{
  "name": "dsh-browser-bridge",
  "version": "0.2.1",
  "description": "dsh server plugin: 给 agent 的浏览器控制工具（browser_navigate/evaluate/screenshot/dom/click/attach/emulate）——默认驱动用户可见的持久 Chrome；target=builtin 经无 CDP 命令通道驱动 DSH 桌面端内置浏览器面板（普通重启即可用、面板自动打开、设备仿真）。运行时零安装：走 venv3 的 Python Playwright 守护进程。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.cjs",
    "lib/browser_daemon.py",
    "cordis.patch.yml",
    "README.md",
    "test"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "browser",
    "playwright",
    "automation",
    "mobile-debug"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.0 <4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
